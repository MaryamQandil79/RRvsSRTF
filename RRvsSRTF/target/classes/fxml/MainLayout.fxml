<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.scheduler.controller.MainController"
            stylesheets="@../css/styles.css"
            prefWidth="1280" prefHeight="820">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <VBox>
                <Label text="CPU SCHEDULING COMPARISON SYSTEM" styleClass="app-title"/>
                <Label text="Round Robin  vs  Shortest Remaining Time First" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Load Scenario:" styleClass="section-label"/>
            <Button fx:id="btnTest1" text="① Basic Mixed"    onAction="#onTest1" styleClass="btn-test"/>
            <Button fx:id="btnTest2" text="② Quantum Effect" onAction="#onTest2" styleClass="btn-test"/>
            <Button fx:id="btnTest3" text="③ Short Jobs"     onAction="#onTest3" styleClass="btn-test"/>
            <Button fx:id="btnTest4" text="④ Fairness"       onAction="#onTest4" styleClass="btn-test"/>
            <Button fx:id="btnTest5" text="⑤ Invalid Demo"   onAction="#onTest5" styleClass="btn-test-warn"/>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="btnRun" text="▶  RUN SIMULATION" onAction="#onRun" styleClass="btn-run"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="0" VBox.vgrow="ALWAYS">


            <VBox styleClass="panel-left" spacing="12" minWidth="230" maxWidth="260">
                <padding><Insets top="16" right="14" bottom="16" left="14"/></padding>
                <Label text="ADD PROCESS" styleClass="panel-heading"/>
                <Separator/>
                <Label text="Process ID" styleClass="field-label"/>
                <TextField fx:id="tfProcessId" promptText="e.g. P1" styleClass="input-field"/>
                <Label text="Arrival Time" styleClass="field-label"/>
                <TextField fx:id="tfArrivalTime" promptText="e.g. 0" styleClass="input-field"/>
                <Label text="Burst Time" styleClass="field-label"/>
                <TextField fx:id="tfBurstTime" promptText="e.g. 5" styleClass="input-field"/>
                <Separator/>
                <Label text="Time Quantum (RR)" styleClass="field-label"/>
                <TextField fx:id="tfQuantum" promptText="e.g. 3" styleClass="input-field"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Separator/>
                <HBox spacing="8">
                    <Button fx:id="btnAddProcess" text="+ Add" onAction="#onAddProcess"
                            styleClass="btn-add" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnRemoveProcess" text="− Remove" onAction="#onRemoveProcess"
                            styleClass="btn-remove" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Button fx:id="btnClearAll" text="Clear All" onAction="#onClearAll"
                        styleClass="btn-clear" maxWidth="Infinity"/>
            </VBox>


            <VBox HBox.hgrow="ALWAYS" spacing="0">

                <!-- Process Table -->
                <VBox styleClass="panel-centre-top" spacing="6">
                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                    <Label text="PROCESS LIST" styleClass="panel-heading"/>
                    <TableView fx:id="tblProcesses" prefHeight="180" maxHeight="180">
                        <columns>
                            <TableColumn fx:id="colId"      text="Process ID"   prefWidth="110"/>
                            <TableColumn fx:id="colArrival" text="Arrival Time" prefWidth="120"/>
                            <TableColumn fx:id="colBurst"   text="Burst Time"   prefWidth="110"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>


                <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="result-tabs">


                    <Tab text="  Round Robin  ">
                        <SplitPane orientation="VERTICAL" dividerPositions="0.35">
                            <VBox spacing="8">
                                <padding><Insets top="10" right="12" bottom="6" left="12"/></padding>
                                <Label text="READY QUEUE SNAPSHOTS" styleClass="section-label"/>
                                <ListView fx:id="lvReadyQueue" prefHeight="100" styleClass="queue-list"/>
                                <Label text="GANTT CHART — ROUND ROBIN" styleClass="section-label"/>
                                <ScrollPane fx:id="spRrGantt" fitToHeight="true" prefHeight="100"
                                            styleClass="gantt-pane" VBox.vgrow="ALWAYS"/>
                            </VBox>
                            <VBox spacing="6">
                                <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                                <Label text="PER-PROCESS METRICS — ROUND ROBIN" styleClass="section-label"/>
                                <TableView fx:id="tblRrMetrics" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRrId"  text="Process"         prefWidth="90"/>
                                        <TableColumn fx:id="colRrCT"  text="Completion Time" prefWidth="130"/>
                                        <TableColumn fx:id="colRrTAT" text="Turnaround Time" prefWidth="130"/>
                                        <TableColumn fx:id="colRrWT"  text="Waiting Time"    prefWidth="110"/>
                                        <TableColumn fx:id="colRrRT"  text="Response Time"   prefWidth="110"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </SplitPane>
                    </Tab>


                    <Tab text="  SRTF  ">
                        <SplitPane orientation="VERTICAL" dividerPositions="0.35">
                            <VBox spacing="8">
                                <padding><Insets top="10" right="12" bottom="6" left="12"/></padding>
                                <Label text="GANTT CHART — SRTF" styleClass="section-label"/>
                                <ScrollPane fx:id="spSrtfGantt" fitToHeight="true"
                                            styleClass="gantt-pane" VBox.vgrow="ALWAYS"/>
                            </VBox>
                            <VBox spacing="6">
                                <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                                <Label text="PER-PROCESS METRICS — SRTF" styleClass="section-label"/>
                                <TableView fx:id="tblSrtfMetrics" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colSrId"  text="Process"         prefWidth="90"/>
                                        <TableColumn fx:id="colSrCT"  text="Completion Time" prefWidth="130"/>
                                        <TableColumn fx:id="colSrTAT" text="Turnaround Time" prefWidth="130"/>
                                        <TableColumn fx:id="colSrWT"  text="Waiting Time"    prefWidth="110"/>
                                        <TableColumn fx:id="colSrRT"  text="Response Time"   prefWidth="110"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </SplitPane>
                    </Tab>


                    <Tab text="  Side by Side  ">
                        <VBox spacing="10">
                            <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>

                            <!-- Gantt Charts -->
                            <HBox spacing="10">
                                <VBox HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="GANTT CHART — ROUND ROBIN" styleClass="section-label"/>
                                    <ScrollPane fx:id="spRrGanttSide" fitToHeight="true" prefHeight="110"
                                                styleClass="gantt-pane"/>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="GANTT CHART — SRTF" styleClass="section-label"/>
                                    <ScrollPane fx:id="spSrtfGanttSide" fitToHeight="true" prefHeight="110"
                                                styleClass="gantt-pane"/>
                                </VBox>
                            </HBox>

                            <Separator/>


                            <HBox spacing="10" VBox.vgrow="ALWAYS">
                                <VBox HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="PER-PROCESS METRICS — ROUND ROBIN" styleClass="section-label"/>
                                    <TableView fx:id="tblRrMetricsSide" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colRrIdS"  text="Process" prefWidth="80"/>
                                            <TableColumn fx:id="colRrCTS"  text="CT"      prefWidth="60"/>
                                            <TableColumn fx:id="colRrTATS" text="TAT"     prefWidth="60"/>
                                            <TableColumn fx:id="colRrWTS"  text="WT"      prefWidth="60"/>
                                            <TableColumn fx:id="colRrRTS"  text="RT"      prefWidth="60"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="PER-PROCESS METRICS — SRTF" styleClass="section-label"/>
                                    <TableView fx:id="tblSrtfMetricsSide" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colSrIdS"  text="Process" prefWidth="80"/>
                                            <TableColumn fx:id="colSrCTS"  text="CT"      prefWidth="60"/>
                                            <TableColumn fx:id="colSrTATS" text="TAT"     prefWidth="60"/>
                                            <TableColumn fx:id="colSrWTS"  text="WT"      prefWidth="60"/>
                                            <TableColumn fx:id="colSrRTS"  text="RT"      prefWidth="60"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                            </HBox>
                        </VBox>
                    </Tab>


                    <Tab text="  Conclusion  ">
                        <VBox spacing="8">
                            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                            <Label text="FINAL COMPARISON &amp; RECOMMENDATION" styleClass="section-label"/>
                            <TextArea fx:id="taConclusion"
                                      editable="false" wrapText="true"
                                      VBox.vgrow="ALWAYS"
                                      styleClass="conclusion-area"
                                      promptText="Run the simulation to see the analysis here."/>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>


            <VBox styleClass="panel-right" spacing="10" minWidth="220" maxWidth="240">
                <padding><Insets top="16" right="14" bottom="16" left="14"/></padding>
                <Label text="COMPARISON SUMMARY" styleClass="panel-heading"/>
                <Separator/>
                <Label text="Round Robin" styleClass="algo-heading-rr"/>
                <GridPane hgap="8" vgap="4">
                    <Label text="Avg WT:"  GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="metric-key"/>
                    <Label fx:id="lblRrAvgWT"  text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="metric-val"/>
                    <Label text="Avg TAT:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="metric-key"/>
                    <Label fx:id="lblRrAvgTAT" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="metric-val"/>
                    <Label text="Avg RT:"  GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="metric-key"/>
                    <Label fx:id="lblRrAvgRT"  text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="metric-val"/>
                </GridPane>
                <Separator/>
                <Label text="SRTF" styleClass="algo-heading-srtf"/>
                <GridPane hgap="8" vgap="4">
                    <Label text="Avg WT:"  GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="metric-key"/>
                    <Label fx:id="lblSrAvgWT"  text="—" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="metric-val"/>
                    <Label text="Avg TAT:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="metric-key"/>
                    <Label fx:id="lblSrAvgTAT" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="metric-val"/>
                    <Label text="Avg RT:"  GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="metric-key"/>
                    <Label fx:id="lblSrAvgRT"  text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="metric-val"/>
                </GridPane>
                <Separator/>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="BETTER OVERALL" styleClass="winner-label-heading"/>
                    <Label fx:id="lblWinner" text="—" styleClass="winner-label"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
                <Separator/>
                <Label text="METRICS KEY" styleClass="section-label"/>
                <Label text="WT   = Waiting Time"    styleClass="legend-text" wrapText="true"/>
                <Label text="TAT  = Turnaround Time" styleClass="legend-text" wrapText="true"/>
                <Label text="RT   = Response Time"   styleClass="legend-text" wrapText="true"/>
                <Label text="CT   = Completion Time" styleClass="legend-text" wrapText="true"/>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="5" right="16" bottom="5" left="16"/></padding>
            <Label text="OS Project – CPU Scheduling Simulator  |  Spring 2025" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Java 17  +  JavaFX 21" styleClass="status-text"/>
        </HBox>
    </bottom>

</BorderPane>